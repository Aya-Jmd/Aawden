*.pt
*.pyc
*.safetensors
.DS_Store
.env
.env.*
.git
.idea
.pytest_cache/
.ruff_cache/
.vendor/
.venv
.venv*
.vscode
__pycache__/
build/
checkpoints/
dist/
runs/
venv
!snapshot/**
!retrain-in/*.safetensors
!retrain-in/*.json
!inputs/localize-aya/*.json
!runs/wsp-v3/wsp-dump2/**
!runs/wsp-v3/wsp-dump3/**
!runs/wsp-v3/proposals/**
!jobinput/**
